# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - PROGRAMMING CAR / SKVIA (HETZNER VPS)
# ==============================================================================
# Copie este archivo como '.env' en su servidor Hetzner:
#   cp .env.production.example .env
# Y modifique los valores con sus credenciales reales seguras.
# ==============================================================================

# 1. DOMINIO PÚBLICO DEL VPS
# El subdominio o dominio apuntando a la IP pública de su VPS Hetzner (ej. A record en DNS)
APP_DOMAIN=app.tuempresa.com

# 2. BASE DE DATOS POSTGRESQL
POSTGRES_DB=sqldb
POSTGRES_USER=postgres
# Genere una contraseña segura (ej. con: openssl rand -base64 24)
POSTGRES_PASSWORD=Cambiar_Por_Password_Seguro_Postgres_2026!

# 3. SEGURIDAD JWT (MÍNIMO 32 CARACTERES / BYTES)
# Puede generar una clave criptográfica de 64 caracteres en terminal con:
# openssl rand -base64 48
JWT_SECRET=CambiarPorUnaClaveCriptograficaMuySeguraDeMinimo32Caracteres2026_xyz123!

# 4. ADMINISTRADOR INICIAL DEL SISTEMA (COLD START)
# Estas credenciales se usarán para crear el primer usuario SuperAdmin
# en caso de que la base de datos esté vacía al primer arranque.
INITIAL_ADMIN_EMAIL=admin@admin.pe
INITIAL_ADMIN_PASSWORD=Admin123*!
INITIAL_ADMIN_NAME=Super Administrador
